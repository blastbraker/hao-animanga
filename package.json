{
  "name": "hao-animanga",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @hao/api --filter @hao/web --filter @hao/worker dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "supabase:start": "pnpm dlx supabase start",
    "supabase:stop": "pnpm dlx supabase stop",
    "supabase:push": "pnpm dlx supabase db push",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "next": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
